{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@mainlanddev/hbx-handlebars-v4",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Alias Pathing */
    "paths": {
      "@/*": ["./src/*"],
      // The JSX runtime the templates compile against: a dependency of hbx-bigcommerce, not of the theme.
      "@mainlanddev/hbx-handlebars-v4/*": ["./node_modules/@mainlanddev/hbx-bigcommerce/node_modules/@mainlanddev/hbx-handlebars-v4/dist/*"]
    }
  },
  "include": ["src", ".hbx/**/*.d.ts"]
}
